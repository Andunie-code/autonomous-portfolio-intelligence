<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Holdout evaluator (ADR-0009, ADR-0013): authoritative cohort registry, diagnostic and prospective evaluation.
       M5: archive window source, real role logins, administration commands (docs/m5-protocol.md §10). Runs as its
       own container; reachable only through its narrow API on the internal eval network.
       Must never reference Research, Execution or the hosts (architecture tests). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kernel\PortfolioIntelligence.Kernel.csproj" />
    <ProjectReference Include="..\Infrastructure\PortfolioIntelligence.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <!-- The H-ENV probe is its own project in the same directory (E8). -->
    <Compile Remove="EnvironmentProbe\**" />
    <None Remove="EnvironmentProbe\**" />
    <Content Remove="EnvironmentProbe\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PortfolioIntelligence.HoldoutEvaluator.Tests" />
  </ItemGroup>
</Project>
