<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The only process that will ever hold exchange credentials (D9, ADR-0001). M5: paper trading worker and the
       loopback-only Ops API (m5-protocol §2–§3). M5b: the read-only M9a dashboard (ADR-0020), embedded files. -->
  <PropertyGroup>
    <UserSecretsId>portfolio-intelligence-trading-host</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Kernel\PortfolioIntelligence.Kernel.csproj" />
    <ProjectReference Include="..\..\Infrastructure\PortfolioIntelligence.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Execution\PortfolioIntelligence.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Dashboard\*" LogicalName="PortfolioIntelligence.Trading.Host.Dashboard.%(Filename)%(Extension)" />
    <Content Remove="Dashboard\**" />
    <None Remove="Dashboard\**" />
  </ItemGroup>
</Project>
