      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(sftp *)",
      "WebFetch(domain:data.binance.vision)",
